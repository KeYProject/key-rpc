// Complex KeY file with multiple declarations
\sorts {
    Integer;
    Real;
    Object;
    MyList;
    MyTree;
}

\functions {
    // Arithmetic functions
    int add(int, int);
    int mult(int, int);
    Real sqrt(Real);
    
    // List functions
    MyList empty();
    MyList cons(Object, MyList);
    Object head(MyList);
    MyList tail(MyList);
    int length(MyList);
    
    // Tree functions  
    MyTree leaf(Object);
    MyTree node(MyTree, MyTree);
    Object getValue(MyTree);
}

\program {
    void example() {
        int x = 5;
        int y = 10;
        int z = add(x, y);
        
        MyList list = empty();
        list = cons(x, list);
        list = cons(y, list);
    }
}

\axioms {
    // Addition axioms
    \forall int x; add(x, 0) = x;
    \forall int x, int y; add(x, y) = add(y, x);
    
    // Multiplication axioms
    \forall int x; mult(x, 0) = 0;
    \forall int x; mult(x, 1) = x;
    
    // List axioms
    \forall Object o, MyList l; head(cons(o, l)) = o;
    \forall Object o, MyList l; tail(cons(o, l)) = l;
    length(empty()) = 0;
}

\rules {
    // Simplification rules
    (add(x, 0) == x) 
    ==> 
    <true> add(x, 0) = x;
}
