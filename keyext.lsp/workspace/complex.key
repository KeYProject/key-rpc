// Complex KeY file with multiple declarations

// \include "test.key";

\sorts {
    Integer;
    Real;
    Object;
    MyList;
    MyTree;
}

\datatypes {
    Colors = Red | Yellow | Blue | Green;
}

\functions {
    // Arithmetic functions
    int add(int, int);
    int mult(int, int);
    Real sqrt(Real);
    
    // List functions
    MyList empty;
    // MyList cons(Object, MyList);
    Object head(MyList);
    MyList tail(MyList);
    int length(MyList);
    
    // Tree functions  
    MyTree leaf(Object);
    MyTree node(MyTree, MyTree);
    Object getValue(MyTree);
}

\axioms {
    a { \forall int x;        add(x, 0) = x }
    b { \forall int x, int y; add(x, y) = add(y, x) }
    
    // Multiplication axioms
    m1 { \forall int x; mult(x, 0) = 0 }
    m2 { \forall int x; mult(x, 1) = x }
    
    // List axioms
    l1 { \forall Object o, MyList l;  head(cons(o, l)) = o }
    l2 { \forall Object o, MyList l; tail(cons(o, l)) = l }
    l3 { length(empty()) = 0 }
}

// Simplification rules
\problem {
    (add(x, 0) = x) ==> add(x, 0) = x
}
