// KeY file with Java program for verification
\program {
    class Counter {
        private int count;
        
        Counter() {
            count = 0;
        }
        
        void increment() {
            count = count + 1;
        }
        
        int getCount() {
            return count;
        }
    }
    
    class Main {
        public static void main(String[] args) {
            Counter c = new Counter();
            c.increment();
            c.increment();
            int result = c.getCount();
        }
    }
}

\functions {
    int get_count(Counter);
}

\axioms {
    \forall Counter c; get_count(c) >= 0;
}
