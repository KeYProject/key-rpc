\datatypes{
    struct Node {
        int value;
        Node next;
    }
}

\functions{
    Node createNode(int v);
    int getValue(Node n);
}

\predicates{
    bool isSorted(Node head);
    bool contains(Node head, int val);
}

\axioms{
    \forall int v; 
        getValue(createNode(v)) = v;
    
    \forall Node n, int v;
        n != null --> getValue(n) >= 0;
}

\problem{
    \forall Node head, int val;
        isSorted(head) && contains(head, val) --> val >= 0
}
